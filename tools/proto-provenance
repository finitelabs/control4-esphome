#!/usr/bin/env sh
# Stamp and verify the provenance header on the generated proto schema.
#
#   proto-provenance stamp <schema> <runtime> <esphome-version>
#   proto-provenance check <schema> <runtime> <esphome-version>
#
# check reads only files already in the tree: no protoc, Python, stylua,
# generator checkout, or network.

set -u

BOUNDARY='-- provenance-boundary: every line below is covered by body-sha256'
BANNER_END='-- Do not edit manually'

die() {
  echo "proto-provenance: $*" >&2
  exit 1
}

sha256() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  else
    die "no sha256 tool found (looked for shasum, sha256sum)"
  fi
}

count_lines() {
  grep -c "$1" "$2" 2>/dev/null || true
}

# lua-protobuf injects VERSION from `git describe --exact-match --tags`, so a
# release build always carries a tag and an untagged tree carries "dev".
runtime_version() {
  file=$1
  [ -f "$file" ] || die "$file not found; cannot determine the generator version"
  n=$(count_lines '^local VERSION = ".*"$' "$file")
  [ "$n" -eq 1 ] || die "expected exactly one VERSION assignment in $file, found $n"
  v=$(sed -n 's/^local VERSION = "\(.*\)"$/\1/p' "$file")
  [ -n "$v" ] || die "VERSION in $file is empty"
  if [ "$v" = "dev" ]; then
    die "$file was built from an untagged lua-protobuf tree (VERSION=dev); vendor a tagged release"
  fi
  case "$v" in
    v[0-9]*) ;;
    *) die "VERSION in $file is not a release tag: '$v'" ;;
  esac
  printf '%s' "$v"
}

boundary_count() {
  count_lines "^$BOUNDARY\$" "$1"
}

body() {
  # Printing before the match is what excludes the boundary line itself.
  awk -v b="$BOUNDARY" 'seen { print } $0 == b { seen = 1 }' "$1"
}

body_hash() {
  body "$1" | sha256
}

# Read a header field from above the boundary only, so a line in the generated
# body cannot impersonate one.
header_field() {
  file=$1
  key=$2
  n=$(awk -v b="$BOUNDARY" -v k="-- $key: " '
    index($0, k) == 1 { c++ }
    $0 == b { exit }
    END { print c + 0 }
  ' "$file")
  [ "$n" -eq 1 ] || die "expected exactly one '$key' line in the $file header, found $n"
  awk -v b="$BOUNDARY" -v k="-- $key: " '
    index($0, k) == 1 { print substr($0, length(k) + 1); exit }
    $0 == b { exit }
  ' "$file"
}

require_header() {
  file=$1
  [ -f "$file" ] || die "$file not found"
  n=$(boundary_count "$file")
  [ "$n" -eq 1 ] || die "$file has $n provenance boundary lines, expected exactly 1; run 'make gen-proto' to regenerate and stamp it"
}

cmd_stamp() {
  schema=$1
  runtime=$2
  esphome=$3
  [ -f "$schema" ] || die "$schema not found"
  [ -n "$esphome" ] || die "esphome version is empty"
  generator=$(runtime_version "$runtime") || exit 1

  tmp=$(mktemp) || die "mktemp failed"
  # Re-stamping keys on the existing boundary; a first stamp keys on the
  # generator's own banner so that banner is not duplicated into the body.
  if [ "$(boundary_count "$schema")" -eq 1 ]; then
    body "$schema" > "$tmp"
  else
    n=$(count_lines "^$BANNER_END\$" "$schema")
    [ "$n" -eq 1 ] || die "expected exactly one '$BANNER_END' line in an unstamped $schema, found $n"
    awk -v b="$BANNER_END" 'seen { print } $0 == b { seen = 1 }' "$schema" > "$tmp"
  fi

  hash=$(sha256 < "$tmp")
  {
    echo "-- Generated Lua schema from protobuf descriptor set"
    echo "$BANNER_END"
    echo "--"
    echo "-- generator: $generator"
    echo "-- esphome: $esphome"
    echo "-- body-sha256: $hash"
    echo "$BOUNDARY"
    cat "$tmp"
  } > "$schema.new"
  rm -f "$tmp"
  mv -f "$schema.new" "$schema"
  echo "stamped $schema: generator $generator, esphome $esphome, body $hash"
}

cmd_check() {
  schema=$1
  runtime=$2
  esphome=$3
  require_header "$schema"
  [ -n "$esphome" ] || die "ESPHOME_VERSION is empty"

  want_generator=$(runtime_version "$runtime") || exit 1
  got_generator=$(header_field "$schema" generator) || exit 1
  got_esphome=$(header_field "$schema" esphome) || exit 1
  got_hash=$(header_field "$schema" body-sha256) || exit 1

  [ "$got_generator" = "$want_generator" ] || die "$schema was generated by $got_generator but $runtime now ships $want_generator; run 'make gen-proto'"
  [ "$got_esphome" = "$esphome" ] || die "$schema was generated from esphome $got_esphome but ESPHOME_VERSION is now $esphome; run 'make gen-proto'"

  have_hash=$(body_hash "$schema")
  [ -n "$have_hash" ] || die "computed an empty body hash for $schema; the provenance header is malformed"
  if [ "$got_hash" != "$have_hash" ]; then
    echo "proto-provenance: $schema body does not match its header" >&2
    echo "  header: $got_hash" >&2
    echo "  actual: $have_hash" >&2
    echo "  The file was edited by hand, or reformatted (a stylua upgrade rewrites it)." >&2
    echo "  Either way, run 'make gen-proto' to regenerate and re-stamp." >&2
    exit 1
  fi
  echo "$schema matches its provenance: generator $got_generator, esphome $got_esphome"
}

[ $# -ge 1 ] || die "usage: proto-provenance stamp|check <schema> <runtime> <esphome-version>"
mode=$1
shift
case "$mode" in
  stamp) [ $# -eq 3 ] || die "usage: proto-provenance stamp <schema> <runtime> <esphome-version>"; cmd_stamp "$@" ;;
  check) [ $# -eq 3 ] || die "usage: proto-provenance check <schema> <runtime> <esphome-version>"; cmd_check "$@" ;;
  *) die "unknown mode '$mode'; expected stamp or check" ;;
esac
