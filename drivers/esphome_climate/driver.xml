<devicedata>
  <name>ESPHome Climate</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>ESPHome Climate</model>
  <creator>Derek Miller</creator>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>03/27/2026 12:00:00 PM</created>
  <modified/>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Comfort</category>
  </composer_categories>
  <conditionals/>
  <events/>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Settings</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver Settings</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <property>
        <name>Outdoor Temperature Source</name>
        <type>LIST</type>
        <items>
          <item>None</item>
          <item>External</item>
        </items>
        <default>None</default>
      </property>
      <!-- Temperature scale is read from the C4 project-level setting via C4:GetProjectProperty("TemperatureScale") -->
      <property>
        <name>Remote Temperature Service</name>
        <type>STRING</type>
        <default>set_remote_temperature</default>
      </property>
      <property>
        <name>Internal Temperature Service</name>
        <type>STRING</type>
        <default>use_internal_temperature</default>
      </property>
    </properties>
    <commands/>
    <actions/>
  </config>
  <capabilities>
    <can_heat>True</can_heat>
    <can_cool>True</can_cool>
    <can_auto>True</can_auto>
    <has_humidity>True</has_humidity>
    <has_single_setpoint>False</has_single_setpoint>
    <setpoint_resolution_c>0.5</setpoint_resolution_c>
    <setpoint_resolution_f>1</setpoint_resolution_f>
    <has_extras>False</has_extras>
    <has_outdoor_temperature>False</has_outdoor_temperature>
    <has_vacation_mode>False</has_vacation_mode>
    <has_remote_sensor>True</has_remote_sensor>
    <fan_modes>Auto,On,Low,Medium,High</fan_modes>
    <hvac_modes>Off,Heat,Cool,Auto</hvac_modes>
    <hold_modes>Off,Home,Away,Eco,Sleep,Boost,Comfort</hold_modes>
    <temperature_c_min>7</temperature_c_min>
    <temperature_c_max>35</temperature_c_max>
    <temperature_f_min>45</temperature_f_min>
    <temperature_f_max>95</temperature_f_max>
  </capabilities>
  <proxies>
    <proxy proxybindingid="5001" primary="True" name="ESPHome Climate">thermostatV2</proxy>
  </proxies>
  <connections>
    <connection>
      <id>5001</id>
      <facing>6</facing>
      <connectionname>Thermostat</connectionname>
      <type>2</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>THERMOSTAT</classname>
        </class>
      </classes>
      <hidden>True</hidden>
    </connection>
    <connection>
      <id>5002</id>
      <facing>6</facing>
      <connectionname>ESPHome Climate</connectionname>
      <type>2</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>ESPHOME_CLIMATE</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
    <connection>
      <id>5003</id>
      <facing>6</facing>
      <connectionname>Remote Temperature Sensor</connectionname>
      <type>1</type>
      <consumer>True</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>TEMPERATURE_VALUE</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
    <connection>
      <id>5010</id>
      <facing>6</facing>
      <connectionname>Temperature</connectionname>
      <type>6</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>TEMPERATURE_VALUE</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
    <connection>
      <id>5012</id>
      <facing>6</facing>
      <connectionname>Humidity</connectionname>
      <type>6</type>
      <consumer>False</consumer>
      <audiosource>False</audiosource>
      <videosource>False</videosource>
      <linelevel>False</linelevel>
      <classes>
        <class>
          <classname>HUMIDITY_VALUE</classname>
        </class>
      </classes>
      <hidden>False</hidden>
    </connection>
  </connections>
</devicedata>
