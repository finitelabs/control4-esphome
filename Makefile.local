# Kept out of Makefile so `copier update` cannot clobber these.

# ESPHome release the committed schema was generated from; bump only together with make gen-proto
ESPHOME_VERSION ?= 2026.10.2
LUA_PROTOBUF ?= ../lua-protobuf
ESPHOME_API := https://raw.githubusercontent.com/esphome/esphome/$(ESPHOME_VERSION)/esphome/components/api
PROTO_SCHEMA := src/esphome/proto_schema.lua
PROTOBUF_RUNTIME := vendor/protobuf.lua
PROTO_PROVENANCE := $(LUA_PROTOBUF)/tools/proto-provenance

.PHONY: gen-proto
gen-proto: ## Regenerate src/esphome/proto_schema.lua from the ESPHome API protos
	@[ -f "$(LUA_PROTOBUF)/Makefile" ] || { echo "lua-protobuf not found at $(LUA_PROTOBUF); set LUA_PROTOBUF=<path>"; exit 1; }
	@[ -x "$(LUA_PROTOBUF)/.venv/bin/python3" ] || $(MAKE) -C "$(LUA_PROTOBUF)" setup-schema-generator
	$(MAKE) -C "$(LUA_PROTOBUF)" gen-schema \
		OUTPUT="$(CURDIR)/$(PROTO_SCHEMA)" \
		PROTO="$(ESPHOME_API)/api.proto $(ESPHOME_API)/api_options.proto"
	@$(MAKE) fmt-lua # normalize the generator's blank lines to the committed style
	@$(PROTO_PROVENANCE) stamp "$(PROTO_SCHEMA)" "$(PROTOBUF_RUNTIME)" "esphome=$(ESPHOME_VERSION)"
	@$(MAKE) check-lua # a header make fmt would rewrite must never reach a commit

.PHONY: protobuf-ref
protobuf-ref: ## Print the lua-protobuf release tag recorded in vendor/protobuf.lua
	@n=$$(grep -c '^local VERSION = ".*"$$' "$(PROTOBUF_RUNTIME)" || true); \
	[ "$$n" -eq 1 ] || { echo "$(PROTOBUF_RUNTIME): expected exactly one VERSION assignment, found $$n" >&2; exit 1; }; \
	v=$$(sed -n 's/^local VERSION = "\(.*\)"$$/\1/p' "$(PROTOBUF_RUNTIME)"); \
	case "$$v" in \
		v[0-9]*) echo "$$v" ;; \
		*) echo "$(PROTOBUF_RUNTIME): VERSION '$$v' is not a lua-protobuf release tag" >&2; exit 1 ;; \
	esac

.PHONY: check-proto
check-proto: ## Assert src/esphome/proto_schema.lua matches its recorded provenance
	@[ -x "$(PROTO_PROVENANCE)" ] || { echo "$(PROTO_PROVENANCE) not found; check out finitelabs/lua-protobuf at the VERSION recorded in $(PROTOBUF_RUNTIME) and set LUA_PROTOBUF=<path>"; exit 1; }
	@$(PROTO_PROVENANCE) check "$(PROTO_SCHEMA)" "$(PROTOBUF_RUNTIME)" "esphome=$(ESPHOME_VERSION)"
